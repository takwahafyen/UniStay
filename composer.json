{
    "name": "student-housing/platform",
    "type": "project",
    "description": "Plateforme moderne de gestion et de recherche de logements étudiants avec Laravel 11 et Elasticsearch.",
    "keywords": ["laravel", "student-housing", "elasticsearch", "docker"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "babenkoivan/elastic-scout-driver": "^3.1",
        "elasticsearch/elasticsearch": "^8.13",
        "laravel/framework": "^11.0",
        "laravel/scout": "^10.8",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "format": [
            "vendor/bin/pint"
        ],
        "test": [
            "vendor/bin/phpunit --testdox"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
